[sub_resource type="GDScript" id="GDScript_8cye3"]
script/source = "extends Node2D

@onready var light = $DirectionalLight2D
@onready var pointLight = $PointLight2D
@onready var pointLight2 = $PointLight2D2
@onready var playersLight = $Player/player/PointLight2D
var state = morning

enum {
	morning,
	day,
	evening,
	night,
}




func _ready():
	light.enabled = true

func _process(delta):
	match state:
		morning:
			morning_state()
		evening:
			evening_state()
		
func morning_state():
	var tween = get_tree().create_tween()
	tween.tween_property(light, \"energy\", 0.05, 20)
	var tweenLight = get_tree().create_tween()
	tweenLight.tween_property(pointLight, \"energy\", 0, 20)
	var pointLightRed  = get_tree().create_tween()
	pointLightRed.tween_property(pointLight2, \"energy\", 0, 20)
	var pTweenLight = get_tree().create_tween()
	pTweenLight.tween_property(playersLight, \"energy\", 0, 20)
	
func evening_state():
	var tween = get_tree().create_tween()
	tween.tween_property(light, \"energy\", 0.95, 20)
	var tweenLight = get_tree().create_tween()
	tweenLight.tween_property(pointLight, \"energy\", 1.5, 20)
	var pointLightRed  = get_tree().create_tween()
	pointLightRed.tween_property(pointLight2, \"energy\", 1.5, 20)
	var pTweenLight = get_tree().create_tween()
	pTweenLight.tween_property(playersLight, \"energy\", 1.2, 20)


func _on_day_night_timeout() -> void:
	if state < 3:
		state += 1
	else:
		state = morning
"

